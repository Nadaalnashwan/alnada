# Copy to .env.local and fill in. Never commit real values.

# ── Meta Llama (primary: Cloudflare Workers AI) ──
LLAMA_PROVIDER=cloudflare            # cloudflare | groq
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=                # token with Workers AI Read + Edit
LLAMA_MODEL=                         # verify with `npm run verify:llama`; default @cf/meta/llama-3.3-70b-instruct-fp8-fast
LLAMA_INTENT_MODEL=                  # optional cheaper Meta model for intent JSON, e.g. @cf/meta/llama-3.1-8b-instruct-fp8
GROQ_API_KEY=                        # only if LLAMA_PROVIDER=groq

# ── Perenual botanical data (import script only) ──
PERENUAL_API_KEY=

# ── Supabase (project "alnada") ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # publishable/anon key (safe for the browser; RLS enforces access)
